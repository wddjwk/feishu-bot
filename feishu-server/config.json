{
  "version": "v2.2.0",
  "feishu": {
    "base_url": "https://open.feishu.cn/open-apis",
    "reply_in_thread": false,
    "reaction_processing": "OnIt",
    "card_width": "half",
    "tool_icons": {
      "qoder": "🦸‍♂️",
      "claude": "🧞",
      "copilot": "🧚",
      "codebuddy": "🧑‍🎤"
    }
  },
  "ai": {
    "timeout_seconds": 36000,
    "max_argument_prompt_bytes": 100000,
    "workspace": "../agent-workspace",
    "auto_memory_resume": true,
    "auto_memory_resume_timeout_seconds": 300,
    "tools": {
      "qoder": {
        "command": "qodercli",
        "base_args": ["--model", "{model}", "--output-format", "stream-json", "--dangerously-skip-permissions"],
        "session_args": ["--session-id", "{session_id}"],
        "resume_args": ["--resume", "{session_id}"],
        "prompt_transport": "stdin",
        "output_parser": "stream_json"
      },
      "claude": {
        "command": "claude",
        "base_args": ["--model", "{model}", "--output-format", "stream-json", "--verbose", "--print", "--dangerously-skip-permissions"],
        "session_args": ["--session-id", "{session_id}"],
        "resume_args": ["--resume", "{session_id}"],
        "prompt_transport": "stdin",
        "output_parser": "stream_json"
      },
      "copilot": {
        "command": "copilot",
        "base_args": ["--model", "{model}", "--output-format", "json", "--no-ask-user", "--allow-all"],
        "session_args": ["--session-id", "{session_id}"],
        "resume_args": ["--resume", "{session_id}"],
        "prompt_transport": "stdin",
        "output_parser": "copilot_json"
      },
      "codebuddy": {
        "command": "codebuddy",
        "base_args": ["--print", "--model", "{model}", "--output-format", "stream-json", "--dangerously-skip-permissions"],
        "session_args": ["--session-id", "{session_id}"],
        "resume_args": ["--resume", "{session_id}"],
        "prompt_transport": "argument",
        "output_parser": "stream_json"
      },
      "pi": {
        "command": "pi",
        "base_args": [ "--print", "--model", "{model}", "--mode", "json", "--approve" ],
        "session_args": [ "--session-id", "{session_id}" ],
        "resume_args": [ "--resume", "{session_id}" ],
        "prompt_transport": "stdin",
        "output_parser": "stream_json"
      }
    }
  },
  "prompt": {
    "group_thread_context_limit": 100,
    "work_root": "../agent-workspace/workfolder"
  },
  "lark_cli": {
    "command": "lark-cli",
    "profile": "feishu-bot-server",
    "timeout_seconds": 120
  },
  "session_store": {
    "path": "data/session_map.json",
    "retention_days": 90,
    "max_links": 500,
    "cleanup_interval_seconds": 3600
  },
  "scheduler": {
    "host": "127.0.0.1",
    "port": 8066,
    "data_file": "data/tasks.json",
    "tick_seconds": 60
  },
  "logging": {
    "level": "INFO",
    "dir": "logs",
    "file_max_bytes": 10485760,
    "backup_count": 10
  }
}
