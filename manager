#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVER_DIR="$ROOT/feishu-server"
LOG_DIR="$SERVER_DIR/logs"
PID_FILE="$ROOT/.server.pid"
VENV_DIR="$ROOT/.venv"
PY="$VENV_DIR/bin/python"
PIP_INDEX="https://mirrors.aliyun.com/pypi/simple"

DOCKER_IMAGE="${FEISHUBOT_IMAGE:-feishubot}"
DOCKER_CONTAINER="${FEISHUBOT_CONTAINER:-feishubot}"
DOCKER_APP="/home/bot/feishu-bot"

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

ok()   { echo -e "${GREEN}[OK]${NC} $*"; }
info() { echo -e "${BLUE}[INFO]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
err()  { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# ─── Shared helpers ───────────────────────────────────────────────────────────

get_user_data_paths() {
  local paths=""
  if [[ -f "$ROOT/config.json" ]]; then
    paths=$(jq -r '.options.user_data[]?' "$ROOT/config.json" 2>/dev/null)
  fi
  if [[ -z "$paths" ]]; then
    paths=$(jq -r '.options.user_data[]?' "$SERVER_DIR/config.json" 2>/dev/null)
  fi
  if [[ -z "$paths" ]]; then
    err "Cannot read options.user_data from config"
    return 1
  fi
  echo "$paths"
}

# ─── Local mode ───────────────────────────────────────────────────────────────

ensure_venv() {
  if [[ ! -x "$PY" ]]; then
    if command -v uv >/dev/null 2>&1; then
      UV_DEFAULT_INDEX="$PIP_INDEX" uv venv "$VENV_DIR"
      UV_DEFAULT_INDEX="$PIP_INDEX" uv pip install --python "$PY" -r "$SERVER_DIR/requirements.txt"
    else
      python3 -m venv "$VENV_DIR"
      "$VENV_DIR/bin/pip" install -i "$PIP_INDEX" -r "$SERVER_DIR/requirements.txt"
    fi
  fi
}

install_hooks() {
  if [[ -d "$ROOT/.git" ]]; then
    mkdir -p "$ROOT/.git/hooks"
    cp "$ROOT/hooks/commit-msg" "$ROOT/.git/hooks/commit-msg"
    chmod +x "$ROOT/.git/hooks/commit-msg"
  fi
}

is_running() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(cat "$PID_FILE")"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

find_latest_log() {
  ls -t "$LOG_DIR"/feishu_server_*.log 2>/dev/null | head -1
}

start() {
  if is_running; then
    warn "FeishuBot is already running: PID=$(cat "$PID_FILE")"
    return 0
  fi
  ensure_venv
  install_hooks
  mkdir -p "$SERVER_DIR/data" "$LOG_DIR"
  cd "$SERVER_DIR"
  setsid "$PY" main.py >/dev/null 2>&1 &
  echo "$!" > "$PID_FILE"
  ok "FeishuBot started: PID=$(cat "$PID_FILE")"
}

stop() {
  if ! is_running; then
    warn "FeishuBot is not running"
    rm -f "$PID_FILE"
    return 0
  fi
  local pid
  pid="$(cat "$PID_FILE")"
  kill -TERM "$pid" 2>/dev/null || true
  for _ in {1..20}; do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$PID_FILE"
      ok "FeishuBot stopped"
      return 0
    fi
    sleep 0.5
  done
  kill -KILL "$pid" 2>/dev/null || true
  rm -f "$PID_FILE"
  err "FeishuBot killed after graceful stop timeout"
}

status() {
  if ! is_running; then
    warn "FeishuBot is not running"
    return 1
  fi
  local pid
  pid="$(cat "$PID_FILE")"
  info "FeishuBot is running: PID=$pid"
  ps -p "$pid" -o pid=,etime=,rss=,cmd=
}

show_log() {
  local log_file
  log_file=$(find_latest_log) || {
    err "No log file found in $LOG_DIR/"
    return 1
  }
  info "Following: $log_file (Ctrl+C to exit)"
  exec tail -f "$log_file"
}

vlog() {
  local editor="${EDITOR:-vim}"
  local log_file

  if [[ -z "${1:-}" ]]; then
    log_file=$(find_latest_log) || {
      err "No log file found in $LOG_DIR/"
      return 1
    }
  else
    local matches
    matches=$(ls "$LOG_DIR"/*"$1"*.log 2>/dev/null || true)
    if [[ -z "$matches" ]]; then
      err "No log file matching '$1' in $LOG_DIR/"
      return 1
    fi
    local count
    count=$(echo "$matches" | wc -l)
    if [[ "$count" -gt 1 ]]; then
      err "Multiple log files match '$1':"
      echo "$matches" >&2
      return 1
    fi
    log_file="$matches"
  fi

  info "Opening: $log_file"
  exec "$editor" "$log_file"
}

update() {
  info "Pulling latest changes..."
  cd "$ROOT"
  git pull --ff-only
  ok "Updated to $(git log --oneline -1)"
  if is_running; then
    info "Restarting service..."
    stop
    start
  fi
}

deferred_restart() {
  local delay="${1:-5}"
  (sleep "$delay"; "$ROOT/manager" restart) >/dev/null 2>&1 &
  info "Deferred restart scheduled after ${delay}s"
}

export_data() {
  local dest="${1:-.}"
  local timestamp
  timestamp=$(date +%Y%m%d-%H%M%S)
  local zip_path="$dest/feishubot-data-${timestamp}.zip"

  mkdir -p "$dest"
  cd "$ROOT"

  local paths=()
  while IFS= read -r p; do
    [[ -e "$ROOT/$p" ]] && paths+=("$p")
  done < <(get_user_data_paths)

  if [[ ${#paths[@]} -eq 0 ]]; then
    err "No exportable data found"
    return 1
  fi

  zip -r "$zip_path" "${paths[@]}"
  ok "Exported to: $zip_path ($(du -h "$zip_path" | cut -f1))"
}

import_data() {
  local zip_file="${1:-}"
  if [[ -z "$zip_file" ]]; then
    err "Usage: $0 import <zip-file>"
    return 1
  fi
  if [[ ! -f "$zip_file" ]]; then
    err "File not found: $zip_file"
    return 1
  fi

  cd "$ROOT"
  unzip -o "$zip_file" -d "$ROOT"
  ok "Imported from: $zip_file"
}

# ─── Docker mode ──────────────────────────────────────────────────────────────

docker_exists() {
  docker inspect "$DOCKER_CONTAINER" &>/dev/null
}

docker_running() {
  [[ "$(docker inspect -f '{{.State.Running}}' "$DOCKER_CONTAINER" 2>/dev/null)" == "true" ]]
}

docker_ensure_running() {
  if ! docker_exists; then
    err "Container '$DOCKER_CONTAINER' does not exist. See: $0 help"
    return 1
  fi
  if ! docker_running; then
    err "Container '$DOCKER_CONTAINER' is not running. Start it first: $0 docker-start"
    return 1
  fi
}

docker_build() {
  info "Building image '$DOCKER_IMAGE'..."
  docker build -t "$DOCKER_IMAGE" "$ROOT"
  ok "Image '$DOCKER_IMAGE' built"
}

docker_start() {
  if docker_running; then
    warn "Container '$DOCKER_CONTAINER' is already running"
    return 0
  fi
  if docker_exists; then
    docker start "$DOCKER_CONTAINER" >/dev/null
    ok "Container '$DOCKER_CONTAINER' started"
  else
    err "Container '$DOCKER_CONTAINER' does not exist. See: $0 help"
    return 1
  fi
}

docker_stop() {
  if ! docker_running; then
    warn "Container '$DOCKER_CONTAINER' is not running"
    return 0
  fi
  docker stop "$DOCKER_CONTAINER" >/dev/null
  ok "Container '$DOCKER_CONTAINER' stopped"
}

docker_status() {
  if ! docker_exists; then
    warn "Container '$DOCKER_CONTAINER' does not exist"
    return 1
  fi
  local state started
  state=$(docker inspect -f '{{.State.Status}}' "$DOCKER_CONTAINER")
  started=$(docker inspect -f '{{.State.StartedAt}}' "$DOCKER_CONTAINER" | cut -dT -f1,2 | cut -d. -f1)
  info "Container: $DOCKER_CONTAINER"
  info "State: $state"
  info "Started: $started"
  if [[ "$state" == "running" ]]; then
    docker top "$DOCKER_CONTAINER" -o pid,etime,rss,cmd 2>/dev/null | head -5
  fi
}

docker_log() {
  docker_ensure_running || return 1
  info "Following container log (Ctrl+C to exit)"
  exec docker exec "$DOCKER_CONTAINER" bash -c \
    "tail -f \$(ls -t $DOCKER_APP/feishu-server/logs/feishu_server_*.log 2>/dev/null | head -1)"
}

docker_vlog() {
  docker_ensure_running || return 1
  local pattern="${1:-}"
  if [[ -z "$pattern" ]]; then
    exec docker exec -it "$DOCKER_CONTAINER" bash -c \
      "vim \$(ls -t $DOCKER_APP/feishu-server/logs/feishu_server_*.log 2>/dev/null | head -1)"
  else
    exec docker exec -it "$DOCKER_CONTAINER" bash -c \
      "vim \$(ls $DOCKER_APP/feishu-server/logs/*${pattern}*.log 2>/dev/null | head -1)"
  fi
}

docker_update() {
  docker_ensure_running || return 1
  info "Pulling latest changes in container..."
  docker exec "$DOCKER_CONTAINER" git -C "$DOCKER_APP" pull --ff-only
  ok "Updated to $(docker exec "$DOCKER_CONTAINER" git -C "$DOCKER_APP" log --oneline -1)"
  info "Restarting container..."
  docker restart "$DOCKER_CONTAINER" >/dev/null
  ok "Container restarted"
}

docker_deferred_restart() {
  local delay="${1:-5}"
  (sleep "$delay"; "$ROOT/manager" docker-restart) >/dev/null 2>&1 &
  info "Deferred docker restart scheduled after ${delay}s"
}

docker_export() {
  docker_ensure_running || return 1
  local dest="${1:-.}"
  local timestamp
  timestamp=$(date +%Y%m%d-%H%M%S)
  local zip_name="feishubot-data-${timestamp}.zip"

  mkdir -p "$dest"

  local paths=()
  while IFS= read -r p; do
    paths+=("$p")
  done < <(get_user_data_paths)

  docker exec "$DOCKER_CONTAINER" bash -c \
    "cd $DOCKER_APP && zip -r /tmp/$zip_name ${paths[*]}"
  docker cp "$DOCKER_CONTAINER:/tmp/$zip_name" "$dest/$zip_name"
  docker exec "$DOCKER_CONTAINER" rm -f "/tmp/$zip_name"
  ok "Exported to: $dest/$zip_name ($(du -h "$dest/$zip_name" | cut -f1))"
}

docker_import() {
  docker_ensure_running || return 1
  local zip_file="${1:-}"
  if [[ -z "$zip_file" ]]; then
    err "Usage: $0 docker-import <zip-file>"
    return 1
  fi
  if [[ ! -f "$zip_file" ]]; then
    err "File not found: $zip_file"
    return 1
  fi

  local zip_name
  zip_name=$(basename "$zip_file")
  docker cp "$zip_file" "$DOCKER_CONTAINER:/tmp/$zip_name"
  docker exec "$DOCKER_CONTAINER" bash -c \
    "cd $DOCKER_APP && unzip -o /tmp/$zip_name && rm -f /tmp/$zip_name"
  ok "Imported from: $zip_file"
}

docker_shell() {
  if ! docker_exists; then
    err "Container '$DOCKER_CONTAINER' does not exist. See: $0 help"
    return 1
  fi
  if ! docker_running; then
    docker start "$DOCKER_CONTAINER" >/dev/null
  fi
  exec docker exec -it "$DOCKER_CONTAINER" bash
}

# ─── Main ─────────────────────────────────────────────────────────────────────

usage() {
  cat <<EOF
Usage: $0 <command>
All commands support docker- prefix to operate on container instead of local process.

  start | docker-start            Start service
  stop | docker-stop              Stop service
  restart | docker-restart        Restart service
  deferred-restart [sec] | docker-deferred-restart [sec]
  status | docker-status          Show status
  log | docker-log                Tail latest log
  vlog [pat] | docker-vlog [pat]  Open log in editor
  update | docker-update          Git pull + restart
  export [dir] | docker-export [dir]
  import <zip> | docker-import <zip>
  docker-shell                    Enter container bash
  docker-build                    Build image

Create container:
  docker run -d \\
    --name $DOCKER_CONTAINER --hostname feishubot --restart unless-stopped \\
    -e FEISHU_APP_ID=cli_xxx \\
    -e FEISHU_APP_SECRET=your_secret \\
    -e MAINTAINER_OPEN_ID=ou_xxx \\
    $DOCKER_IMAGE

Env: FEISHUBOT_IMAGE (default: feishubot), FEISHUBOT_CONTAINER (default: feishubot)
EOF
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  deferred-restart) deferred_restart "${2:-5}" ;;
  status) status ;;
  log) show_log ;;
  vlog) vlog "${2:-}" ;;
  update) update ;;
  export) export_data "${2:-.}" ;;
  import) import_data "${2:-}" ;;
  docker-start) docker_start ;;
  docker-stop) docker_stop ;;
  docker-restart) docker_stop; docker_start ;;
  docker-deferred-restart) docker_deferred_restart "${2:-5}" ;;
  docker-status) docker_status ;;
  docker-log) docker_log ;;
  docker-vlog) docker_vlog "${2:-}" ;;
  docker-update) docker_update ;;
  docker-export) docker_export "${2:-.}" ;;
  docker-import) docker_import "${2:-}" ;;
  docker-build) docker_build ;;
  docker-shell) docker_shell ;;
  help|--help|-h) usage ;;
  *) usage >&2; exit 2 ;;
esac
