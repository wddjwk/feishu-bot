#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVER_DIR="$ROOT/feishu-server"
LOG_DIR="$SERVER_DIR/logs"
PID_FILE="$ROOT/.server.pid"
VENV_DIR="$ROOT/.venv"
PY="$VENV_DIR/bin/python"
PIP_INDEX="https://mirrors.aliyun.com/pypi/simple"

DOCKER_IMAGE="${FEISHUBOT_IMAGE:-feishubot}"
DOCKER_CONTAINER="${FEISHUBOT_CONTAINER:-feishubot}"
DOCKER_APP="/home/bot/feishu-bot"

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

ok()   { echo -e "${GREEN}[OK]${NC} $*"; }
info() { echo -e "${BLUE}[INFO]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
err()  { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# ─── Shared helpers ───────────────────────────────────────────────────────────

get_user_data_paths() {
  local paths=""
  if [[ -f "$ROOT/config.json" ]]; then
    paths=$(jq -r '.options.user_data[]?' "$ROOT/config.json" 2>/dev/null)
  fi
  if [[ -z "$paths" ]]; then
    paths=$(jq -r '.options.user_data[]?' "$SERVER_DIR/config.json" 2>/dev/null)
  fi
  if [[ -z "$paths" ]]; then
    err "Cannot read options.user_data from config"
    return 1
  fi
  echo "$paths"
}

# ─── Local mode ───────────────────────────────────────────────────────────────

ensure_venv() {
  if [[ ! -x "$PY" ]]; then
    if command -v uv >/dev/null 2>&1; then
      UV_DEFAULT_INDEX="$PIP_INDEX" uv venv "$VENV_DIR"
      UV_DEFAULT_INDEX="$PIP_INDEX" uv pip install --python "$PY" -r "$SERVER_DIR/requirements.txt"
    else
      python3 -m venv "$VENV_DIR"
      "$VENV_DIR/bin/pip" install -i "$PIP_INDEX" -r "$SERVER_DIR/requirements.txt"
    fi
  fi
}

install_hooks() {
  if [[ -d "$ROOT/.git" ]]; then
    mkdir -p "$ROOT/.git/hooks"
    cp "$ROOT/hooks/commit-msg" "$ROOT/.git/hooks/commit-msg"
    chmod +x "$ROOT/.git/hooks/commit-msg"
  fi
}

is_running() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(cat "$PID_FILE")"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

find_latest_log() {
  ls -t "$LOG_DIR"/feishu_server_*.log 2>/dev/null | head -1
}

start() {
  if is_running; then
    warn "FeishuBot is already running: PID=$(cat "$PID_FILE")"
    return 0
  fi
  ensure_venv
  install_hooks
  mkdir -p "$SERVER_DIR/data" "$LOG_DIR"
  cd "$SERVER_DIR"
  setsid "$PY" main.py >/dev/null 2>&1 &
  echo "$!" > "$PID_FILE"
  ok "FeishuBot started: PID=$(cat "$PID_FILE")"
}

stop() {
  if ! is_running; then
    warn "FeishuBot is not running"
    rm -f "$PID_FILE"
    return 0
  fi
  local pid
  pid="$(cat "$PID_FILE")"
  kill -TERM "$pid" 2>/dev/null || true
  for _ in {1..20}; do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$PID_FILE"
      ok "FeishuBot stopped"
      return 0
    fi
    sleep 0.5
  done
  kill -KILL "$pid" 2>/dev/null || true
  rm -f "$PID_FILE"
  err "FeishuBot killed after graceful stop timeout"
}

status() {
  if ! is_running; then
    warn "FeishuBot is not running"
    return 1
  fi
  local pid
  pid="$(cat "$PID_FILE")"
  info "FeishuBot is running: PID=$pid"
  ps -p "$pid" -o pid=,etime=,rss=,cmd=
}

show_log() {
  local log_file
  log_file=$(find_latest_log) || {
    err "No log file found in $LOG_DIR/"
    return 1
  }
  info "Following: $log_file (Ctrl+C to exit)"
  exec tail -f "$log_file"
}

vlog() {
  local editor="${EDITOR:-vim}"
  local log_file

  if [[ -z "${1:-}" ]]; then
    log_file=$(find_latest_log) || {
      err "No log file found in $LOG_DIR/"
      return 1
    }
  else
    local matches
    matches=$(ls "$LOG_DIR"/*"$1"*.log 2>/dev/null || true)
    if [[ -z "$matches" ]]; then
      err "No log file matching '$1' in $LOG_DIR/"
      return 1
    fi
    local count
    count=$(echo "$matches" | wc -l)
    if [[ "$count" -gt 1 ]]; then
      err "Multiple log files match '$1':"
      echo "$matches" >&2
      return 1
    fi
    log_file="$matches"
  fi

  info "Opening: $log_file"
  exec "$editor" "$log_file"
}

update() {
  info "Pulling latest changes..."
  cd "$ROOT"
  git pull --ff-only
  ok "Updated to $(git log --oneline -1)"
  if is_running; then
    info "Restarting service..."
    stop
    start
  fi
}

deferred_restart() {
  local delay="${1:-5}"
  (sleep "$delay"; "$ROOT/manager" restart) >/dev/null 2>&1 &
  info "Deferred restart scheduled after ${delay}s"
}

export_data() {
  local dest="${1:-.}"
  local timestamp
  timestamp=$(date +%Y%m%d-%H%M%S)
  local zip_path="$dest/feishubot-data-${timestamp}.zip"

  mkdir -p "$dest"
  cd "$ROOT"

  local paths=()
  while IFS= read -r p; do
    [[ -e "$ROOT/$p" ]] && paths+=("$p")
  done < <(get_user_data_paths)

  if [[ ${#paths[@]} -eq 0 ]]; then
    err "No exportable data found"
    return 1
  fi

  zip -r "$zip_path" "${paths[@]}"
  ok "Exported to: $zip_path ($(du -h "$zip_path" | cut -f1))"
}

import_data() {
  local zip_file="${1:-}"
  if [[ -z "$zip_file" ]]; then
    err "Usage: $0 import <zip-file>"
    return 1
  fi
  if [[ ! -f "$zip_file" ]]; then
    err "File not found: $zip_file"
    return 1
  fi

  cd "$ROOT"
  unzip -o "$zip_file" -d "$ROOT"
  ok "Imported from: $zip_file"
}

# ─── Docker mode ──────────────────────────────────────────────────────────────

docker_exists() {
  docker container inspect "$DOCKER_CONTAINER" &>/dev/null
}

docker_running() {
  [[ "$(docker container inspect -f '{{.State.Running}}' "$DOCKER_CONTAINER" 2>/dev/null)" == "true" ]]
}

docker_ensure_running() {
  if ! docker_exists; then
    err "Container '$DOCKER_CONTAINER' does not exist. See: $0 help"
    return 1
  fi
  if ! docker_running; then
    docker start "$DOCKER_CONTAINER" >/dev/null
  fi
}

docker_build() {
  info "Building image '$DOCKER_IMAGE'..."
  docker build -t "$DOCKER_IMAGE" "$ROOT"
  ok "Image '$DOCKER_IMAGE' built"
}

docker_create() {
  if docker_exists; then
    warn "Container '$DOCKER_CONTAINER' already exists"
    return 0
  fi
  docker run -dit \
    --name "$DOCKER_CONTAINER" \
    --hostname feishubot \
    --restart unless-stopped \
    "$DOCKER_IMAGE"
  ok "Container '$DOCKER_CONTAINER' created. Enter with: $0 docker-shell"
}

docker_shell() {
  docker_ensure_running || return 1
  exec docker exec -it "$DOCKER_CONTAINER" bash
}

docker_exec() {
  docker_ensure_running || return 1
  exec docker exec -it "$DOCKER_CONTAINER" "$DOCKER_APP/manager" "$@"
}

# ─── Main ─────────────────────────────────────────────────────────────────────

usage() {
  cat <<EOF
Usage: $0 <command>

Lifecycle:
  start                 Start service
  stop                  Stop service
  restart               Stop + start
  deferred-restart [s]  Restart after delay (default 5s)

Monitoring:
  status                Show service status
  log                   Tail latest log
  vlog [pattern]        Open log in editor

Maintenance:
  update                Git pull + restart
  export [dir]          Export user data to zip
  import <zip>          Import user data from zip

Docker (docker-<command> forwards to container's ./manager <command>):
  docker-build          Build image
  docker-create         Create container
  docker-shell          Enter container bash
  docker-*              Same as above, but executed inside container. Like docker-start, docker-stop, docker-status, etc.

EOF
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  deferred-restart) deferred_restart "${2:-5}" ;;
  status) status ;;
  log) show_log ;;
  vlog) vlog "${2:-}" ;;
  update) update ;;
  export) export_data "${2:-.}" ;;
  import) import_data "${2:-}" ;;
  docker-build) docker_build ;;
  docker-create) docker_create ;;
  docker-shell) docker_shell ;;
  docker-*) docker_exec "${1#docker-}" "${@:2}" ;;
  help|--help|-h) usage ;;
  *) usage >&2; exit 2 ;;
esac
